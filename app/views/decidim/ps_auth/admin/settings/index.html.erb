<% add_decidim_page_title(t("decidim.admin.titles.settings")) %>
<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t "decidim.admin.titles.settings" %>
      <% if allowed_to? :create, :authorization %>
        <%= link_to t("actions.setting.new", scope: "decidim.admin"), [:new, :setting], class: "button button__sm button__secondary" %>
      <% end %>
    </h1>
  </div>
  <%= admin_filter_selector %>
  <div class="table-scroll">
    <table class="table-list">
      <thead>
      <tr>
        <th><%= sort_link(query, :name, t("models.setting.fields.name", scope: "decidim.admin"), default_order: :desc) %></th>
        <th><%= sort_link(query, :authorizables_resource_type, t("models.setting.fields.authorizables", scope: "decidim.admin"), default_order: :desc) %></th>
        <th><%= sort_link(query, :created_at, t("models.setting.fields.created_at", scope: "decidim.admin"), default_order: :desc) %></th>
        <th></th>
      </tr>
      </thead>
      <tbody>
      <% @settings.each do |setting| %>
        <tr data-setting-id="<%= setting.id %>">
          <td><%= setting.name %></td>
          <td><%= render_authorizables(setting) %></td>
          <td><%= l setting.created_at, format: :short %></td>
          <td class="table-list__actions">
            <% if allowed_to? :show, :authorization, setting: setting  %>
              <%= icon_link_to "eye-line",
                               "javascript: void(0);",
                               t("actions.show", scope: "decidim.admin"),
                               class: "action-icon--eye",
                               data: { dialog_open: "show-cfs", "dialog-remote-url": cfs_list_setting_path(setting) } %>
            <% end %>
            <% if allowed_to? :edit, :authorization, setting: setting  %>
              <%= icon_link_to "pencil-line", edit_setting_path(setting), t("actions.edit", scope: "decidim.admin"), class: "action-icon--edit" %>
            <% end %>

            <% if allowed_to? :destroy, :authorization, setting: setting %>
              <%= icon_link_to "delete-bin-line", setting, t("actions.destroy", scope: "decidim.admin"), class: "action-icon--remove", method: :delete, data: { confirm: t("actions.confirm_destroy", scope: "decidim.admin") } %>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
<%= decidim_paginate @settings %>
<%= render "show_cfs_modal" %>
